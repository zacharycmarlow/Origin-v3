# Origin-v3 / MetaMyth — Environment Variables Example
# Copy to .env and fill in. Never commit .env.

# ── Frontend (Vite public — exposed to browser) ──────────────────
VITE_PRIVY_APP_ID=cmtrpl49m00sq0clamltxzaof
VITE_API_BASE_URL=

# ── API Worker (server-side only — never exposed) ────────────────
# Anthropic (first-choice AI provider for readings)
ANTHROPIC_API_KEY=

# Privy (JWT verification — public app ID, secret from Privy dashboard)
PRIVY_APP_ID=cmtrpl49m00sq0clamltxzaof
PRIVY_APP_SECRET=

# Sentry (optional — error tracking)
SENTRY_DSN=

# Resend (optional — transactional email)
RESEND_API_KEY=

# Web Push (optional — push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google / YouTube (optional — YouTube publishing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare (local dev with wrangler) ────────────────────────
# D1 database ID (from wrangler.toml)
# R2 bucket name: origin-media
